# Backend configuration only. Never expose this key in browser JavaScript.
LLM_BASE_URL=https://api.xkiro.com/v1
LLM_MODEL=mistralai/mistral-large-2512
# Paste your API key after the equals sign, then save this file.
LLM_API_KEY=

# Optional model storage location; defaults to ./models
# MODELS_DIR=E:/MedDesk-model-cache/models
CPU_THREADS=4
# Enter actual provider USD rates; blank means unknown, not zero.
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

# Small CPU-friendly default; other profiles remain selectable.
DEFAULT_STT_PROFILE=zipformer
WHISPER_CPU_THREADS=2

# Conservative initial voice-match thresholds; calibrate with target recordings.
VOICE_MATCH_THRESHOLD=0.70
VOICE_MATCH_MARGIN=0.10
# Optional Fernet key on non-Windows hosts; Windows uses current-user DPAPI by default.
# VOICE_ENCRYPTION_KEY=
